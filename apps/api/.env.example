# Copie para .env e preencha.

NODE_ENV=development
PORT=3333

# Desenvolvimento local (docker compose). As duas URLs podem ser iguais.
DATABASE_URL=postgresql://salonflow:salonflow@localhost:5432/salonflow
DIRECT_URL=postgresql://salonflow:salonflow@localhost:5432/salonflow

# Produção (Supabase > Project Settings > Database > Connection string):
# DATABASE_URL = pooler em modo "Session" (porta 5432)  -> usado pela API
# DIRECT_URL   = conexão direta                          -> usado pelas migrations

# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...). NUNCA vai para o front.
# Usada para o salão redefinir a senha de alguém da equipe. Opcional.
SUPABASE_SECRET_KEY=

# Origens do front liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000
