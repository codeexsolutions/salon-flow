// Schema do banco (PostgreSQL / Supabase).
// A URL de conexão fica em prisma.config.ts (Prisma 7+).
//
// Convenções:
// - Modelos e campos em português, camelCase no código e snake_case no banco (@map / @@map).
// - Toda tabela que pertence a um salão tem `salaoId` (isolamento multi-tenant).
// - IDs são UUID gerados pelo banco.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  DONO
  RECEPCAO
  PROFISSIONAL
}

/// Usuário do sistema. O `id` é o mesmo do usuário no Supabase Auth.
/// Um usuário sem nenhum vínculo em MembroSalao é apenas cliente (marketplace).
model Usuario {
  id        String   @id @db.Uuid
  email     String   @unique
  nome      String?
  avatarUrl String?  @map("avatar_url")
  criadoEm  DateTime @default(now()) @map("criado_em")

  vinculos      MembroSalao[]
  profissionais Profissional[]
  clientes      Cliente[]

  @@map("usuarios")
}

model Salao {
  id                   String   @id @default(uuid()) @db.Uuid
  nome                 String
  slug                 String   @unique
  telefone             String?
  cidade               String?
  uf                   String?  @db.Char(2)
  visivelNoMarketplace Boolean  @default(true) @map("visivel_no_marketplace")
  /// Fuso horário IANA usado para interpretar horários de agenda, jornada e folgas.
  fusoHorario          String   @default("America/Sao_Paulo") @map("fuso_horario")
  /// Comissão padrão em pontos-base (5000 = 50,00%), usada quando não há regra específica.
  comissaoPadraoBps    Int      @default(5000) @map("comissao_padrao_bps")
  /// Se true, a comissão é calculada sobre o valor líquido (descontadas as taxas de pagamento).
  comissaoSobreLiquido Boolean  @default(false) @map("comissao_sobre_liquido")
  ativo                Boolean  @default(true)
  criadoEm             DateTime @default(now()) @map("criado_em")
  atualizadoEm         DateTime @updatedAt @map("atualizado_em")

  membros              MembroSalao[]
  profissionais        Profissional[]
  jornadaIntervalos    JornadaIntervalo[]
  bloqueiosAgenda      BloqueioAgenda[]
  servicos             Servico[]
  servicoProfissionais ServicoProfissional[]
  clientes             Cliente[]
  agendamentos         Agendamento[]
  taxasPagamento       TaxaPagamento[]
  regrasComissao       RegraComissao[]
  comandas             Comanda[]
  comandaItens         ComandaItem[]
  pagamentos           Pagamento[]

  @@index([cidade, uf])
  @@map("saloes")
}

/// Vínculo de um usuário com um salão e o papel dele lá dentro.
model MembroSalao {
  id        String   @id @default(uuid()) @db.Uuid
  salaoId   String   @map("salao_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  papel     Papel
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  salao   Salao   @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([salaoId, usuarioId])
  @@index([usuarioId])
  @@map("membros_salao")
}

/// Profissional que atende no salão. Pode existir sem acesso ao app (usuarioId nulo).
/// Se tiver e-mail, a conta é vinculada automaticamente quando ele entra com esse e-mail.
model Profissional {
  id           String   @id @default(uuid()) @db.Uuid
  salaoId      String   @map("salao_id") @db.Uuid
  usuarioId    String?  @map("usuario_id") @db.Uuid
  nome         String
  email        String?
  telefone     String?
  corAgenda    String   @default("#7c3aed") @map("cor_agenda")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  salao          Salao                 @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  usuario        Usuario?              @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  jornada        JornadaIntervalo[]
  bloqueios      BloqueioAgenda[]
  servicos       ServicoProfissional[]
  agendamentos   Agendamento[]
  regrasComissao RegraComissao[]
  comandaItens   ComandaItem[]

  @@unique([salaoId, email])
  @@unique([salaoId, usuarioId])
  @@index([salaoId, ativo])
  @@index([email])
  @@map("profissionais")
}

/// Um intervalo de trabalho num dia da semana. Vários por dia = pausas (ex.: almoço).
model JornadaIntervalo {
  id             String @id @default(uuid()) @db.Uuid
  salaoId        String @map("salao_id") @db.Uuid
  profissionalId String @map("profissional_id") @db.Uuid
  /// 0 = domingo ... 6 = sábado
  diaSemana      Int    @map("dia_semana") @db.SmallInt
  /// Minutos desde 00:00 (ex.: 540 = 09:00), no fuso do salão.
  inicioMin      Int    @map("inicio_min") @db.SmallInt
  fimMin         Int    @map("fim_min") @db.SmallInt

  salao        Salao        @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([profissionalId, diaSemana])
  @@map("jornada_intervalos")
}

/// Período em que o profissional não atende: folga, férias, compromisso.
model BloqueioAgenda {
  id             String   @id @default(uuid()) @db.Uuid
  salaoId        String   @map("salao_id") @db.Uuid
  profissionalId String   @map("profissional_id") @db.Uuid
  inicio         DateTime @db.Timestamptz
  fim            DateTime @db.Timestamptz
  motivo         String?
  criadoEm       DateTime @default(now()) @map("criado_em")

  salao        Salao        @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([profissionalId, inicio])
  @@map("bloqueios_agenda")
}

/// Serviço oferecido pelo salão. Valores em centavos para evitar erro de arredondamento.
model Servico {
  id            String   @id @default(uuid()) @db.Uuid
  salaoId       String   @map("salao_id") @db.Uuid
  nome          String
  descricao     String?
  categoria     String?
  precoCentavos Int      @map("preco_centavos")
  duracaoMin    Int      @map("duracao_min") @db.SmallInt
  /// Se o cliente pode agendar sozinho pelo app (false = só pela recepção).
  visivelOnline Boolean  @default(true) @map("visivel_online")
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  salao          Salao                 @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  profissionais  ServicoProfissional[]
  agendamentos   Agendamento[]
  regrasComissao RegraComissao[]
  comandaItens   ComandaItem[]

  @@unique([salaoId, nome])
  @@index([salaoId, ativo])
  @@map("servicos")
}

/// Quem faz o serviço. Preço/duração próprios são opcionais (null = usa os do serviço).
model ServicoProfissional {
  servicoId      String @map("servico_id") @db.Uuid
  profissionalId String @map("profissional_id") @db.Uuid
  salaoId        String @map("salao_id") @db.Uuid
  precoCentavos  Int?   @map("preco_centavos")
  duracaoMin     Int?   @map("duracao_min") @db.SmallInt

  servico      Servico      @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  salao        Salao        @relation(fields: [salaoId], references: [id], onDelete: Cascade)

  @@id([servicoId, profissionalId])
  @@index([profissionalId])
  @@map("servicos_profissionais")
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  CONCLUIDO
  CANCELADO
  FALTOU
}

enum OrigemAgendamento {
  /// Criado pela equipe no painel
  SALAO
  /// Criado pelo cliente no app (marketplace / página do salão)
  APP_CLIENTE
}

/// Ficha do cliente NO SALÃO. Pode existir sem conta no app (usuarioId nulo);
/// quem agenda pelo app tem a ficha vinculada à própria conta.
model Cliente {
  id           String   @id @default(uuid()) @db.Uuid
  salaoId      String   @map("salao_id") @db.Uuid
  usuarioId    String?  @map("usuario_id") @db.Uuid
  nome         String
  telefone     String?
  email        String?
  observacoes  String?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  salao        Salao         @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  usuario      Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  agendamentos Agendamento[]
  comandas     Comanda[]

  @@unique([salaoId, usuarioId])
  @@index([salaoId, nome])
  @@map("clientes")
}

/// Um serviço, com um profissional, num horário. Preço e duração são gravados
/// no momento do agendamento (mudanças futuras no serviço não afetam este).
model Agendamento {
  id             String            @id @default(uuid()) @db.Uuid
  salaoId        String            @map("salao_id") @db.Uuid
  clienteId      String            @map("cliente_id") @db.Uuid
  profissionalId String            @map("profissional_id") @db.Uuid
  servicoId      String            @map("servico_id") @db.Uuid
  inicio         DateTime          @db.Timestamptz
  fim            DateTime          @db.Timestamptz
  precoCentavos  Int               @map("preco_centavos")
  status         StatusAgendamento @default(AGENDADO)
  origem         OrigemAgendamento @default(SALAO)
  observacoes    String?
  criadoPorId    String?           @map("criado_por_id") @db.Uuid
  criadoEm       DateTime          @default(now()) @map("criado_em")
  atualizadoEm   DateTime          @updatedAt @map("atualizado_em")

  salao        Salao        @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: NoAction)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: NoAction)
  servico      Servico      @relation(fields: [servicoId], references: [id], onDelete: NoAction)
  comandaItem  ComandaItem?

  @@index([salaoId, inicio])
  @@index([profissionalId, inicio])
  @@index([clienteId, inicio])
  @@map("agendamentos")
}

enum FormaPagamento {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  OUTRO
}

enum StatusComanda {
  ABERTA
  FECHADA
  CANCELADA
}

/// Taxa cobrada pela forma de pagamento (ex.: maquininha), em pontos-base.
model TaxaPagamento {
  id      String         @id @default(uuid()) @db.Uuid
  salaoId String         @map("salao_id") @db.Uuid
  forma   FormaPagamento
  taxaBps Int            @map("taxa_bps")

  salao Salao @relation(fields: [salaoId], references: [id], onDelete: Cascade)

  @@unique([salaoId, forma])
  @@map("taxas_pagamento")
}

/// Regra de comissão. Prioridade: profissional+serviço > serviço > profissional > padrão do salão.
model RegraComissao {
  id             String  @id @default(uuid()) @db.Uuid
  salaoId        String  @map("salao_id") @db.Uuid
  profissionalId String? @map("profissional_id") @db.Uuid
  servicoId      String? @map("servico_id") @db.Uuid
  percentualBps  Int     @map("percentual_bps")

  salao        Salao         @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  profissional Profissional? @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  servico      Servico?      @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@index([salaoId])
  @@map("regras_comissao")
}

/// Comanda: o que o cliente consumiu e como pagou. Ao fechar, as comissões são gravadas nos itens.
model Comanda {
  id               String        @id @default(uuid()) @db.Uuid
  salaoId          String        @map("salao_id") @db.Uuid
  /// Número sequencial por salão (para a equipe falar "comanda 42").
  numero           Int
  clienteId        String?       @map("cliente_id") @db.Uuid
  status           StatusComanda @default(ABERTA)
  descontoCentavos Int           @default(0) @map("desconto_centavos")
  /// Preenchidos ao fechar.
  subtotalCentavos Int?          @map("subtotal_centavos")
  totalCentavos    Int?          @map("total_centavos")
  observacoes      String?
  abertaEm         DateTime      @default(now()) @map("aberta_em")
  abertaPorId      String?       @map("aberta_por_id") @db.Uuid
  fechadaEm        DateTime?     @map("fechada_em")
  fechadaPorId     String?       @map("fechada_por_id") @db.Uuid

  salao      Salao         @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  cliente    Cliente?      @relation(fields: [clienteId], references: [id], onDelete: NoAction)
  itens      ComandaItem[]
  pagamentos Pagamento[]

  @@unique([salaoId, numero])
  @@index([salaoId, status])
  @@index([salaoId, fechadaEm])
  @@map("comandas")
}

/// Item da comanda (por enquanto, serviços). Rateios e comissão gravados no fechamento.
model ComandaItem {
  id                      String  @id @default(uuid()) @db.Uuid
  comandaId               String  @map("comanda_id") @db.Uuid
  salaoId                 String  @map("salao_id") @db.Uuid
  servicoId               String  @map("servico_id") @db.Uuid
  profissionalId          String  @map("profissional_id") @db.Uuid
  agendamentoId           String? @unique @map("agendamento_id") @db.Uuid
  descricao               String
  valorCentavos           Int     @map("valor_centavos")
  descontoRateadoCentavos Int?    @map("desconto_rateado_centavos")
  taxaRateadaCentavos     Int?    @map("taxa_rateada_centavos")
  baseComissaoCentavos    Int?    @map("base_comissao_centavos")
  comissaoBps             Int?    @map("comissao_bps")
  comissaoCentavos        Int?    @map("comissao_centavos")

  comanda      Comanda      @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  salao        Salao        @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  servico      Servico      @relation(fields: [servicoId], references: [id], onDelete: NoAction)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: NoAction)
  agendamento  Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)

  @@index([comandaId])
  @@index([salaoId, profissionalId])
  @@map("comanda_itens")
}

/// Pagamento da comanda (uma comanda pode ter várias formas). Taxa gravada no fechamento.
model Pagamento {
  id            String         @id @default(uuid()) @db.Uuid
  comandaId     String         @map("comanda_id") @db.Uuid
  salaoId       String         @map("salao_id") @db.Uuid
  forma         FormaPagamento
  valorCentavos Int            @map("valor_centavos")
  taxaBps       Int            @default(0) @map("taxa_bps")
  taxaCentavos  Int            @default(0) @map("taxa_centavos")

  comanda Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  salao   Salao   @relation(fields: [salaoId], references: [id], onDelete: Cascade)

  @@index([comandaId])
  @@map("pagamentos")
}
