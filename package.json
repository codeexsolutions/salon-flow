{
  "name": "salonflow",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --workspace=@salonflow/api --",
    "db:studio": "npm run prisma:studio --workspace=@salonflow/api"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "turbo": "^2.11.6"
  }
}
