// Schema do banco (PostgreSQL / Supabase).
// A URL de conexão fica em prisma.config.ts (Prisma 7+).
//
// Convenções:
// - Modelos e campos em português, camelCase no código e snake_case no banco (@map / @@map).
// - Toda tabela que pertence a um salão tem `salaoId` (isolamento multi-tenant).
// - IDs são UUID gerados pelo banco.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  DONO
  RECEPCAO
  PROFISSIONAL
}

/// Usuário do sistema. O `id` é o mesmo do usuário no Supabase Auth.
/// Um usuário sem nenhum vínculo em MembroSalao é apenas cliente (marketplace).
model Usuario {
  id        String   @id @db.Uuid
  email     String   @unique
  nome      String?
  avatarUrl String?  @map("avatar_url")
  criadoEm  DateTime @default(now()) @map("criado_em")

  vinculos MembroSalao[]

  @@map("usuarios")
}

model Salao {
  id                   String   @id @default(uuid()) @db.Uuid
  nome                 String
  slug                 String   @unique
  telefone             String?
  cidade               String?
  uf                   String?  @db.Char(2)
  visivelNoMarketplace Boolean  @default(true) @map("visivel_no_marketplace")
  ativo                Boolean  @default(true)
  criadoEm             DateTime @default(now()) @map("criado_em")
  atualizadoEm         DateTime @updatedAt @map("atualizado_em")

  membros MembroSalao[]

  @@index([cidade, uf])
  @@map("saloes")
}

/// Vínculo de um usuário com um salão e o papel dele lá dentro.
model MembroSalao {
  id        String   @id @default(uuid()) @db.Uuid
  salaoId   String   @map("salao_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  papel     Papel
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  salao   Salao   @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([salaoId, usuarioId])
  @@index([usuarioId])
  @@map("membros_salao")
}
